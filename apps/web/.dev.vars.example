# apps/web/.dev.vars

# ---- AUTH ---- #
AUTH_SECRET=your-value
THREAD_LIST_CURSOR_SECRET=a-long-random-secret

# ---- RESEND ---- #
RESEND_API_KEY=re_xxxxxxxxx

# ---- CLOUDFLARE ---- #
CLOUDFLARE_TEAM_DOMAIN=your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=your-access-app-audience-tag

# ---- SENTRY ---- #
# (server/edge — not exposed to browser)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=1

# ---- SENTRY ---- #
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Client — NEXT_PUBLIC_ prefix required for browser exposure
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1

# ---- OPTIONAL ---- #
# Only used by /api/trigger-inbound in non-production environments
E2E_TEST_SECRET=a-random-secret-for-e2e-tests-only
