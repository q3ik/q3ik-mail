# Dependencies
node_modules/

# Wrangler local state (D1 SQLite files, KV, R2, etc.)
.wrangler/

# Wrangler account cache (contains local account metadata)
node_modules/.cache/wrangler/

# Generated type files (regenerated via `wrangler types`)
worker-configuration.d.ts

# pnpm state files (machine-local: absolute paths + timestamps)
node_modules/.modules.yaml
node_modules/.pnpm-workspace-state-v1.json

# pnpm virtual store (machine-generated, never commit)
node_modules/.pnpm/

# NOTE: pnpm-lock.yaml is intentionally NOT ignored — commit it for deterministic installs

# macOS metadata
.DS_Store
**/.DS_Store

# Next.js build output
.next/
out/

# TypeScript build info (incremental compilation cache)
*.tsbuildinfo

# Environment files
.env
.env.local
.env.*.local

# Build artifacts
dist/
.vercel/

# Test results (generated, uploaded as CI artifacts)
**/test-results/
**/playwright-report/
**/coverage/

